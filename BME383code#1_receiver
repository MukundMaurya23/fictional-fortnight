// %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// COMMUNICATION LIBRARIES AND DEFINITIONS (Do not modify unless you have to!)
#include <WiFi.h>
#include <esp_now.h>

#define ESPNOW_WIFI_CHANNEL 6
// %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

// =============================================================================
// STUDENT'S ADDITIONAL LIBRARIES AND DEFINITIONS HERE:

// =============================================================================

// %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// COMMUNICATION PACKET SET UP (Do not modify unless you have to!)
// --- Data packet structure — must match the TRANSMITTER exactly ---
struct ControlPacket {

 uint16_t SensorVal1; // Left EMG: 0 → 4095

 uint16_t SensorVal2; // Right EMG: 0 → 4095

 uint16_t SensorVal3; // Speed/throttle sensor: 0 → 4095

};

// --- Communcation Global variables ---
volatile ControlPacket latestPacket = {0, 0, 0}; // Default: stopped
volatile bool newDataAvailable = false;
unsigned long lastReceiveTime  = 0;
const int SIGNAL_TIMEOUT_MS = 5000;
uint16_t sensorValue1;
uint16_t sensorValue2;


// --- ESP-NOW receive callback ---
void onDataReceived(const esp_now_recv_info_t *info, const uint8_t *data, int len) {
  if (len == sizeof(ControlPacket)) {
    memcpy((void *)&latestPacket, data, sizeof(ControlPacket));
    newDataAvailable = true;
    lastReceiveTime  = millis();
    digitalWrite(LED_BUILTIN,HIGH);
    delay(100);
    digitalWrite(LED_BUILTIN,LOW);
    delay(100);
  }
}
// %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

// =============================================================================
// STUDENT'S GLOBAL VARIABLES:
// Tank drive Pins
  int leftMotorSpeed = 0;
  int rightMotorSpeed = 0;

  int leftEMG = 0;
  int rightEMG = 0;
  int throttleSensor = 0;

  int leftEMGFiltered = 0;
  int rightEMGFiltered = 0;
  int throttleFiltered = 0;

  int lastLeftEMG = 0;
  int lastRightEMG = 0;
  int lastThrottle = 0;

  // Raise these if motors move while your arms are relaxed.
  // Lower them if the car does not respond enough.

  int leftEMGcap = 2000;
  int rightEMGcap = 2000;

  // Throttle threshold.
  // Raise this if the speed sensor has a high resting value.
  int throttleCap = 500;
  
  // Smoothing.
  // Higher = more responsive but jumpier.
  // Lower = smoother but slower.
  float alpha = 0.75f;
// =============================================================================

void setup() {
  // %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  // COMMUNICATION SETUP() (Do not modify unless you have to!)
  Serial.begin(115200);
  Serial.println("=== RECEIVER starting ===");
  pinMode(LED_BUILTIN,OUTPUT);
  digitalWrite(LED_BUILTIN,LOW);

  // --- Starts Wifi and print this board's MAC address --
  WiFi.mode(WIFI_MODE_STA);
  WiFi.setChannel(ESPNOW_WIFI_CHANNEL);
  while (!WiFi.STA.started()) {
    delay(100);
  }
  Serial.print(">>> RECEIVER MAC ADDRESS (copy into transmitter code): ");
  Serial.println(WiFi.macAddress()); // Copy this mac address to your transmitter code

  // --- Initialise ESP-NOW ---
  if (esp_now_init() != ESP_OK) {
    Serial.println("ERROR: ESP-NOW init failed. Restart the board.");
    while (true);
  }
  esp_now_register_recv_cb(onDataReceived);

  Serial.println("Waiting for transmitter...");
  // %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


  // =============================================================================
  // STUDENT'S SETUP() CODE STARTS HERE:
  // Set up Left and Right Motor Pins
  pinMode(leftMotorPin1, OUTPUT);
  pinMode(leftMotorPin2, OUTPUT);
  pinMode(rightMotorPin1, OUTPUT);
  pinMode(rightMotorPin2, OUTPUT);

  // Set up direction for motor
  digitalWrite(leftMotorPin1, LOW);
  digitalWrite(leftMotorPin2, LOW);
  digitalWrite(rightMotorPin1, LOW);
  digitalWrite(rightMotorPin2, LOW);
  // =============================================================================
}

void loop() {
  // %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  // COMMUNICATION SIGNAL LOST CHECK (Do not modify unless you have to!)
  if (millis() - lastReceiveTime > SIGNAL_TIMEOUT_MS && lastReceiveTime != 0) {
    Serial.println("⚠ Signal lost — motors stopped.");
    lastReceiveTime = millis(); // Prevent spamming the serial port
    return;
  }

  if (!newDataAvailable) return;
  newDataAvailable = false;
  // %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

  // =============================================================================
  // STUDENT'S MAIN LOOP() CODE STARTS HERE:
  // Read the three incoming sensor values
  leftEMG = latestPacket.SensorVal1;
  rightEMG = latestPacket.SensorVal2;
  throttleSensor = latestPacket.SensorVal3;

  // Smooth each signal
  leftEMGFiltered = round(leftEMG * alpha + lastLeftEMG * (1.0 - alpha));
  rightEMGFiltered = round(rightEMG * alpha + lastRightEMG * (1.0 - alpha));
  throttleFiltered = round(throttleSensor * alpha + lastThrottle * (1.0 - alpha));

  lastLeftEMG = leftEMGFiltered;
  lastRightEMG = rightEMGFiltered;
  lastThrottle = throttleFiltered;

  // Convert throttle sensor into a 0–255 speed limit
  int maxSpeed = map(throttleFiltered, throttleCap, 4095, 0, 255);
  maxSpeed = constrain(maxSpeed, 0, 255);

  // Convert each EMG into a 0–255 wheel command
  int leftCommand = map(leftEMGFiltered, leftEMGcap, 4095, 0, 255);
  leftCommand = constrain(leftCommand, 0, 255);

  int rightCommand = map(rightEMGFiltered, rightEMGcap, 4095, 0, 255);
  rightCommand = constrain(rightCommand, 0, 255);

  // Combine EMG wheel command with throttle.
  // This makes the speed sensor act like the gas pedal.
  leftMotorSpeed = map(leftCommand, 0, 255, 0, maxSpeed);
  rightMotorSpeed = map(rightCommand, 0, 255, 0, maxSpeed);

  // Write to Motors
  analogWrite(leftMotorPin1, leftMotorSpeed);
  digitalWrite(leftMotorPin2, LOW);
  analogWrite(rightMotorPin1, rightMotorSpeed);
  digitalWrite(rightMotorPin2, LOW);

  // Print data
  // Print data
  Serial.print("Left EMG: ");
  Serial.print(leftEMGFiltered);

  Serial.print(", Right EMG: ");
  Serial.print(rightEMGFiltered);

  Serial.print(", Throttle: ");
  Serial.print(throttleFiltered);

  Serial.print(", MaxSpeed: ");
  Serial.print(maxSpeed);

  Serial.print(", Left Motor: ");
  Serial.print(leftMotorSpeed);

  Serial.print(", Right Motor: ");
  Serial.println(rightMotorSpeed);
  // =============================================================================
}
